{
  "name": "cleanspot",
  "private": true,
  "version": "0.1.0",
  "description": "Report and clear illegal waste dumps — open source, DSGVO-friendly.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "cloud:link": "node scripts/with-cloud-env.mjs supabase link --project-ref {SUPABASE_PROJECT_REF} --password {SUPABASE_DB_PASSWORD}",
    "cloud:push": "node scripts/with-cloud-env.mjs supabase db push --linked --password {SUPABASE_DB_PASSWORD} --yes",
    "cloud:push:dry": "node scripts/with-cloud-env.mjs supabase db push --linked --password {SUPABASE_DB_PASSWORD} --dry-run",
    "cloud:migrations": "node scripts/with-cloud-env.mjs supabase migration list --linked --password {SUPABASE_DB_PASSWORD}",
    "cloud:maintenance": "node scripts/cloud-maintenance-setup.mjs",
    "verify:remote": "vitest run --config vitest.remote.config.ts",
    "i18n:review": "node scripts/i18n-review.mjs",
    "cloud:status": "node scripts/cloud-env-status.mjs",
    "cloud:auth-config": "node scripts/cloud-auth-config.mjs",
    "demo:status": "node scripts/cloud-env-status.mjs --target demo",
    "demo:push:dry": "node scripts/with-cloud-env.mjs --target demo supabase db push --db-url {SUPABASE_DB_URL} --dry-run",
    "demo:push": "node scripts/with-cloud-env.mjs --target demo supabase db push --db-url {SUPABASE_DB_URL} --yes",
    "demo:migrations": "node scripts/with-cloud-env.mjs --target demo supabase migration list --db-url {SUPABASE_DB_URL}",
    "demo:maintenance": "node scripts/cloud-maintenance-setup.mjs --target demo",
    "demo:auth-config": "node scripts/cloud-auth-config.mjs --target demo",
    "demo:frontend-env": "node scripts/cloud-frontend-env.mjs --target demo --force --demo",
    "check:tiles": "playwright test -c e2e-manual/playwright.config.ts",
    "cloud:frontend-env": "node scripts/cloud-frontend-env.mjs",
    "demo": "node scripts/demo.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "android:keystore": "node scripts/android-keystore.mjs",
    "android:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/gradle.mjs assembleDebug",
    "android:aab": "npm run android:sync && node scripts/gradle.mjs bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "i18next": "^26.4.2",
    "maplibre-gl": "^6.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1"
  }
}
