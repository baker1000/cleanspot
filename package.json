{
  "name": "cleanspot",
  "private": true,
  "version": "0.1.0",
  "description": "Report and clear illegal waste dumps — open source, DSGVO-friendly.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "cloud:link": "node scripts/with-cloud-env.mjs supabase link --project-ref {SUPABASE_PROJECT_REF} --password {SUPABASE_DB_PASSWORD}",
    "cloud:push": "node scripts/with-cloud-env.mjs supabase db push --linked --password {SUPABASE_DB_PASSWORD} --yes",
    "cloud:push:dry": "node scripts/with-cloud-env.mjs supabase db push --linked --password {SUPABASE_DB_PASSWORD} --dry-run",
    "cloud:migrations": "node scripts/with-cloud-env.mjs supabase migration list --linked --password {SUPABASE_DB_PASSWORD}",
    "cloud:maintenance": "node scripts/cloud-maintenance-setup.mjs",
    "verify:remote": "vitest run --config vitest.remote.config.ts",
    "i18n:review": "node scripts/i18n-review.mjs",
    "cloud:status": "node scripts/cloud-env-status.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
