# Copy to .env.local and fill in. Never commit real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# --- Supabase (public values: URL + anon key are safe to expose; RLS protects data) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Map (OpenFreeMap by default; swap for a self-hosted PMTiles style in Docker mode) ---
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Place search. Provider: nominatim | none (none hides the search box).
# The public Nominatim server allows max 1 request/s and no autocomplete; the app enforces both.
# For heavier use (e.g. a Landkreis rollout), point this at a self-hosted Nominatim.
VITE_GEOCODER_PROVIDER=nominatim
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org
# Optional: limit results to countries (ISO codes, comma-separated), e.g. de
VITE_GEOCODER_COUNTRYCODES=

# --- Landing page: link to the Android app (empty = "coming soon" note). Only play.google.com. ---
VITE_PLAY_STORE_URL=

# --- Demo mode (notice + demo account switcher; NEVER enable in production) ---
# The demo accounts share one password (`npm run demo -- seed` writes it to demo-login.local;
# `npm run cloud:frontend-env -- --force --demo` copies it here). It is public in such a build.
VITE_DEMO_MODE=false
VITE_DEMO_PASSWORD=

# --- Server-side only (Edge Functions / Docker). Never prefix with VITE_. ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (optional). Leave empty: the app works fully without email. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=CleanSpot
