# Template for the two cloud projects (both files git-ignored; same variable names):
#   .env.supabase-cloud  verify project, only for `npm run verify:remote` (cloud:* scripts)
#   .env.supabase-demo   demo and pitch project with the demo data (demo:* scripts)
# Never commit the real files, never paste these values into a chat.
#
# Where to find each value in the Supabase dashboard (https://supabase.com/dashboard):

# Account (top right) -> Access Tokens -> Generate new token. Lets the CLI link/push. SECRET.
SUPABASE_ACCESS_TOKEN=

# Project Settings -> General -> Project ID (e.g. abcdefghijklmnopqrst). Not secret.
SUPABASE_PROJECT_REF=

# The database password you chose when creating the project
# (reset it under Project Settings -> Database if you no longer have it). SECRET.
SUPABASE_DB_PASSWORD=

# "Connect" button (top of the project page) -> Connection String -> "Session pooler"
# (IPv4-compatible). Replace [YOUR-PASSWORD] with the DB password. SECRET.
# Looks like: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (<region> is your project region, e.g. eu-west-1 for Ireland or eu-central-1 for Frankfurt.)
SUPABASE_DB_URL=

# Project Settings -> API Keys. URL: https://<ref>.supabase.co
SUPABASE_URL=
# "Publishable key" (sb_publishable_...) or legacy "anon" key. Public by design.
SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...) or legacy "service_role" key. SECRET — full access, bypasses RLS.
SUPABASE_SECRET_KEY=

# Optional: path to the CA certificate (Project Settings -> Database -> SSL -> Download) to verify
# the database server certificate. Without it the connection is encrypted but not verified.
SUPABASE_DB_CA_CERT=

# Filled in automatically by the setup step for the maintenance Edge Function. Leave empty.
MAINTENANCE_SECRET=
